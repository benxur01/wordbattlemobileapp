# Copy to .env and fill in before `docker compose up`.

# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# The *Web* OAuth client id from Google Cloud Console (not the Android one) —
# "web" meaning a client that runs on a server, which is what this is. It has
# to match ApiConfig.googleServerClientId in the app: the app asks Google to
# address the token to this id, and the server accepts nothing else.
#
# The value below is the one committed in the app. Replace both if you point
# the project at a different Google project; leave empty to disable Google
# login; password login remains available. Development can enable the dev
# login separately with DEV_LOGIN_ENABLED=true.
GOOGLE_WEB_CLIENT_ID=238943789457-tgpjf2jamd6r8m0ottqn0ik9ce76gpe2.apps.googleusercontent.com

# Never enable in production: it hands out tokens to anyone who asks. With
# SPRING_PROFILES_ACTIVE=prod the server refuses to start while this is true.
DEV_LOGIN_ENABLED=false

# The users.id to make an admin on startup. There is no other way to create the
# first one: the role is a column on `users` and only the admin panel grants it,
# so an empty value here means the panel is closed to everybody. Sign in once,
# read your id from GET /api/users/me, put it here and restart. Safe to leave
# set afterwards — an account that already holds the role is not touched.
ADMIN_BOOTSTRAP_USER_ID=

# Android App Links for shared tournament links: the SHA-256 fingerprint of
# every certificate the release app is signed with, comma-separated, as keytool
# prints them. With Play App Signing that is the "App signing key certificate"
# from Play Console (Setup -> App signing), plus the upload key if you install
# builds signed with it directly. Served at /.well-known/assetlinks.json; empty
# serves an empty list, and Android then opens the links in the browser.
ASSETLINKS_SHA256=

# Named on the public /privacy and /terms pages: the address players write to
# about their data, and who runs the service (a company or a sole trader).
# Empty falls back to the placeholders support@example.uz and "Word Battle",
# which no store will accept for a published app.
LEGAL_CONTACT_EMAIL=
LEGAL_OPERATOR_NAME=

# Good enough for a laptop and nowhere else — it is printed right here, so
# anyone with the repository has it. Generate a real one for a deployment:
#   openssl rand -base64 24
DB_PASSWORD=wordbattle

# Set to `prod` on a real deployment. It turns on checks for the sample DB
# password, dev login, and placeholder legal contact details.
SPRING_PROFILES_ACTIVE=

# The API's plain HTTP port is loopback-only by default, for a same-host HTTPS
# reverse proxy. Set this to 0.0.0.0 only for LAN development (for example, a
# phone connecting to the laptop's local server address).
API_BIND_ADDRESS=127.0.0.1
