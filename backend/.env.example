# Copy to .env and fill in before `docker compose up`.

# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# The *Web* OAuth client id from Google Cloud Console (not the Android one) —
# "web" meaning a client that runs on a server, which is what this is. It has
# to match ApiConfig.googleServerClientId in the app: the app asks Google to
# address the token to this id, and the server accepts nothing else.
#
# The value below is the one committed in the app. Replace both if you point
# the project at a different Google project; leave empty to disable Google
# login and run on the dev login alone.
GOOGLE_WEB_CLIENT_ID=238943789457-tgpjf2jamd6r8m0ottqn0ik9ce76gpe2.apps.googleusercontent.com

# Never enable in production: it hands out tokens to anyone who asks.
DEV_LOGIN_ENABLED=false

DB_PASSWORD=wordbattle
