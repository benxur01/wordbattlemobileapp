# Copy to .env and fill in before `docker compose up`.

# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# From @BotFather. Leave empty to run without Telegram login (dev login only).
TELEGRAM_BOT_TOKEN=

# Never enable in production: it hands out tokens for any Telegram id.
DEV_LOGIN_ENABLED=false

DB_PASSWORD=wordbattle
