<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Word Battle</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>word_battle</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- Reserved for future iOS Google Sign-In. Once that flow is implemented,
	     Google sends the result back through this scheme. It is the iOS client
	     id turned inside out: drop the trailing
	     `.apps.googleusercontent.com` from GIDClientID below and put it in
	     front instead — `com.googleusercontent.apps.<what is left>`. Cloud
	     Console shows the finished value as "iOS URL scheme". -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.TODO-PASTE-IOS-CLIENT-ID</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Reserved for future iOS Google sign-in. The app intentionally does not
	     show or invoke Google login on iOS until Sign in with Apple is implemented.
	     If both are added, keep GIDClientID and the callback URL scheme in sync;
	     see README → "3. Google Sign-In" → "iOS". -->

	<!-- TODO: the iOS OAuth client — Cloud Console → APIs & Services →
	     Credentials → Create credentials → OAuth client ID → iOS, registered
	     against bundle id com.wordbattle.wordBattle (note: not the Android
	     package, which is com.wordbattle.word_battle). Unlike the Android
	     client this one is used directly, so keep the scheme above in sync. -->
	<key>GIDClientID</key>
	<string>TODO-PASTE-IOS-CLIENT-ID.apps.googleusercontent.com</string>

	<!-- Reserved for future iOS Google sign-in. When that flow is implemented,
	     this must equal ApiConfig.googleServerClientId and the server's
	     GOOGLE_WEB_CLIENT_ID, or the backend will reject the token audience. -->
	<key>GIDServerClientID</key>
	<string>238943789457-tgpjf2jamd6r8m0ottqn0ik9ce76gpe2.apps.googleusercontent.com</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
